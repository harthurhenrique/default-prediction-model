renv::install(c(
"tidyverse",   # manipulação e gráficos (dplyr, ggplot2, readr)
"tidymodels",  # pipeline de machine learning (recipes, parsnip, yardstick)
"janitor",     # limpeza e padronização de colunas
"skimr",       # relatórios rápidos de estatística descritiva
"themis",      # balanceamento de classes (SMOTE, downsample)
"vip"          # importância de variáveis para modelos de risco
))
install.packages("renv")
options(repos = c(CRAN = "https://cloud.r-project.org"))
install.packages(c("tidyverse", "tidymodels", "janitor", "skimr", "themis", "vip"))
options(renv.download.override = FALSE)
options(repos = c(CRAN = "https://cloud.r-project.org"))
utils::install.packages(
c("tidyverse", "tidymodels", "janitor", "skimr", "themis", "vip"),
type = "win.binary"
)
renv::snapshot()
